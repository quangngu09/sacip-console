# Sao chép thành .env.local (không commit) để trang Hồ sơ định danh đọc dữ liệu thật khi chạy npm run dev.
# Bỏ VITE_PROFILES_LIVE thì trang dùng dữ liệu giả lập như cũ.
VITE_PROFILES_LIVE=1

# Chỉ proxy của máy chủ dev đọc các biến dưới đây; chúng không vào bundle của trình duyệt.
SACIP_API_BASE=https://test-openapi.dainam.edu.vn
SACIP_PROCESS_ID=
SACIP_BEARER_TOKEN=
SACIP_API_KEY=
